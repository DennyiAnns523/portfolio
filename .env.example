# Copy to .env.local and fill in. Never commit real values.

# MongoDB. Local: `npm run db:up` (credentials from docker-compose.yml).
# Production: a MongoDB Atlas URI for a user with readWrite on this database only.
MONGODB_URI=mongodb://portfolio:change-me-locally@127.0.0.1:27017/portfolio?authSource=admin

# The one admin account. Generate the hash with: npm run hash-password
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=

# 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SECRET=

# Optional: your public origin. When set, POST/PATCH/DELETE must come from exactly this origin.
APP_ORIGIN=

# Optional: e-mail me when someone leaves a note (e.g. smtps://user:app-password@smtp.gmail.com:465).
SMTP_URL=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=
